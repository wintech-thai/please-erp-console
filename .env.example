# ── Server-side only (runtime, not exposed to browser) ──────────────────────
# URL ของ onix-v2-api backend (ไม่มี trailing slash)
# Dev:        https://api-dev.please-erp.com
# Production: https://api.please-erp.com
BACKEND_URL=https://api-dev.please-erp.com

# ── Build-time (ต้องส่งเป็น --build-arg ตอน docker build) ──────────────────
# บทบาทของ instance: ADMIN หรือ TENANT
NEXT_PUBLIC_WEB_ROLE=ADMIN

# Base URL ของ API proxy (ปกติไม่ต้องเปลี่ยน)
NEXT_PUBLIC_API_URL=/api/proxy

# เวอร์ชันแอป (ใส่โดย CI/CD pipeline)
NEXT_PUBLIC_APP_VERSION=1.0.0

# Storage API base URL (optional)
# Dev:        https://storage-api-dev.please-erp.com
# Production: https://storage-api.please-erp.com
# NEXT_PUBLIC_STORAGE_API_BASE=https://storage-api-dev.please-erp.com
